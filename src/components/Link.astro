---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a
  href={href}
  target={ external ? "_blank" : "_self" }
  class={cn("inline-block decoration-black/20 dark:decoration-white/30 hover:decoration-black/40 hover:dark:decoration-white/60 text-current hover:text-black hover:dark:text-white transition-all duration-300 ease-in-out", underline && "underline underline-offset-2 hover:underline-offset-4")}
  {...rest}>
  <slot/>
</a>
