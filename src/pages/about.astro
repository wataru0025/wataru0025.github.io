---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHero from "@components/PageHero.astro";
import AtCoderTracker from "@components/AtCoderTracker.astro";
import { SOCIALS, ATCODER } from "@consts";

const socialLabels: Record<string, string> = {
  "twitter-x": "X / Twitter",
  github: "GitHub",
};

const sideLinks = [
  ...SOCIALS.map((social) => ({
    label: socialLabels[social.NAME] ?? social.NAME,
    href: social.HREF,
  })),
  { label: "AtCoder", href: `https://atcoder.jp/users/${ATCODER.HANDLE}` },
];

const interests = [
  "競技プログラミング",
  "アプリ開発(今がんばってます)",
  "ゲーム(LoL,Valorant,etc...)",
];

const languages = ["C++", "Python", "Latex"];
const tools = ["Aviutl", "Blender"];

const specs = [
  { key: "CPU", value: "Ryzen 7 9800XX3D 8-Core" },
  { key: "GPU", value: "NVIDIA GeForce RTX 5070" },
  { key: "RAM", value: "32GB" },
  { key: "Storage", value: "SSD 1TB / HDD 6TB" },
  { key: "OS", value: "Windows 11 Home" },
];
---

<PageLayout title="About" description="cotton のプロフィール、使っている道具、AtCoder のレート">
  <PageHero eyebrow="自己紹介" title="About" />

  <div class="main">
    <Container class="cols">
      <aside class="side animate">
        <h2>Profile</h2>
        <p>
          電気通信大学、情報理工学域に通う大学生です。最近は競技プログラミングにはまっています。
        </p>
        <ul class="linklist">
          {
            sideLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label} <span>↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>

      <div class="content">
        <section class="section animate">
          <div class="section-head">
            <h2>Interests</h2>
            <span class="count">趣味・興味</span>
          </div>
          <ul class="tl">
            {
              interests.map((interest) => (
                <li>
                  <time>—</time>
                  <span>{interest}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <AtCoderTracker />

        <section class="section animate">
          <div class="section-head">
            <h2>Skills</h2>
            <span class="count">よく使うもの</span>
          </div>
          <div class="now">
            <h3>言語</h3>
            <div class="tags" style="padding-left:16px">
              {languages.map((lang) => <span class="tag">{lang}</span>)}
            </div>
          </div>
          <div class="now">
            <h3>ツール</h3>
            <div class="tags" style="padding-left:16px">
              {tools.map((tool) => <span class="tag">{tool}</span>)}
            </div>
          </div>
        </section>

        <section class="section animate">
          <div class="section-head">
            <h2>Machine</h2>
            <span class="count">PC環境</span>
          </div>
          <ul class="spec">
            {
              specs.map((spec) => (
                <li>
                  <span class="key">{spec.key}</span>
                  <span>{spec.value}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </Container>
  </div>
</PageLayout>
