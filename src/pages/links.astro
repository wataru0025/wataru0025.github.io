---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHero from "@components/PageHero.astro";

const friends = [
  { name: "しおり", href: "https://shiori-02-14.github.io/Homepage/", icon: "/icons/shiori.jpg", note: "" },
  { name: "柴犬被り", href: "https://memo.shibadogcap.com/", icon: "/icons/shiba.jpg", note: "" },
  { name: "トラマト", href: "https://toramutton.me/", icon: "/icons/toramutton.jpg", note: "" },
  { name: "Fasky", href: "https://thunfasky.com/", icon: "/icons/fasky.jpg", note: "" },
  { name: "てせ", href: "https://ctes091x.net/", icon: "/icons/tese.jpg", note: "" },
  { name: "えぬぴー", href: "https://negapainter.work/", icon: "/icons/np.jpg", note: "" },
  { name: "募集中", href: "https://google.com", icon: null, note: "知り合い勝手に入れるかも" },
];
---

<PageLayout title="Links" description="友人のサイトなど、行き先のリスト">
  <PageHero eyebrow="行き先" title="Links" />

  <div class="main">
    <Container>
      <section class="section animate">
        <div class="section-head">
          <h2>Friends</h2>
          <span class="count">{String(friends.length).padStart(2, "0")}</span>
        </div>
        {
          friends.map((friend) => (
            <a class="friend" href={friend.href} target="_blank" rel="noopener noreferrer">
              {
                friend.icon ? (
                  <img src={friend.icon} alt="" loading="lazy" />
                ) : (
                  <span class="friend-blank" aria-hidden="true">+</span>
                )
              }
              <span>
                <span class="friend-name">{friend.name}</span>
                {friend.note && <span class="friend-note">{friend.note}</span>}
              </span>
              <span class="friend-go">↗</span>
            </a>
          ))
        }
      </section>
    </Container>
  </div>
</PageLayout>
