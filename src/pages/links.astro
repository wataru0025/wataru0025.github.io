---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<PageLayout title="Links" description="Friends and other interesting sites">
  <Container>
    <h1 class="font-semibold text-2xl mb-6">Links</h1>
    <div class="space-y-4">
      <a
        href="https://shiori-02-14.github.io/Homepage/"
        target="_blank"
        class="block p-4 border border-black/15 dark:border-white/20 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
      >
        <div class="flex items-center gap-4">
          <img
            src="/icons/shiori.jpg"
            alt="しおり"
            class="w-12 h-12 rounded-full object-cover shadow-md ring-2 ring-black/5 dark:ring-white/15"
            loading="lazy"
          />
          <div class="space-y-1">
            <h3 class="font-semibold">しおり</h3>
            <p class="text-sm opacity-75"></p>
          </div>
        </div>
      </a>
      
      <a
        href="https://memo.shibadogcap.com/"
        target="_blank"
        class="block p-4 border border-black/15 dark:border-white/20 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
      >
        <div class="flex items-center gap-4">
          <img
            src="/icons/shiba.jpg"
            alt="柴犬被り"
            class="w-12 h-12 rounded-full object-cover shadow-md ring-2 ring-black/5 dark:ring-white/15"
            loading="lazy"
          />
          <div class="space-y-1">
            <h3 class="font-semibold">柴犬被り</h3>
            <p class="text-sm opacity-75"></p>
          </div>
        </div>
      </a>

      <a
        href="https://toramutton.me/"
        target="_blank"
        class="block p-4 border border-black/15 dark:border-white/20 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
      >
        <div class="flex items-center gap-4">
          <img
            src="/icons/toramutton.jpg"
            alt="トラマト"
            class="w-12 h-12 rounded-full object-cover shadow-md ring-2 ring-black/5 dark:ring-white/15"
            loading="lazy"
          />
          <div class="space-y-1">
            <h3 class="font-semibold">トラマト</h3>
            <p class="text-sm opacity-75"></p>
          </div>
        </div>
      </a>
      
      <a
        href="https://thunfasky.com/"
        target="_blank"
        class="block p-4 border border-black/15 dark:border-white/20 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
      >
        <div class="flex items-center gap-4">
          <img
            src="/icons/fasky.jpg"
            alt="Fasky"
            class="w-12 h-12 rounded-full object-cover shadow-md ring-2 ring-black/5 dark:ring-white/15"
            loading="lazy"
          />
          <div class="space-y-1">
            <h3 class="font-semibold">Fasky</h3>
            <p class="text-sm opacity-75"></p>
          </div>
        </div>
      </a>

      <a
        href="https://ctes091x.net/"
        target="_blank"
        class="block p-4 border border-black/15 dark:border-white/20 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
      >
        <div class="flex items-center gap-4">
          <img
            src="/icons/tese.jpg"
            alt="てせ"
            class="w-12 h-12 rounded-full object-cover shadow-md ring-2 ring-black/5 dark:ring-white/15"
            loading="lazy"
          />
          <div class="space-y-1">
            <h3 class="font-semibold">てせ</h3>
            <p class="text-sm opacity-75"></p>
          </div>
        </div>
      </a>

      <a
        href="https://google.com"
        target="_blank"
        class="block p-4 border border-black/15 dark:border-white/20 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
      >
        <div class="flex items-center gap-4">
          <img
            src="/icons/placeholder.png"
            alt="募集中"
            class="w-12 h-12 rounded-full object-cover shadow-md ring-2 ring-black/5 dark:ring-white/15"
            loading="lazy"
          />
          <div class="space-y-1">
            <h3 class="font-semibold">募集中</h3>
            <p class="text-sm opacity-75">知り合い勝手に入れるかも</p>
          </div>
        </div>
      </a>

      </div>

  </Container>
</PageLayout>